        }
      }
    },
    "Your details were saved, but the photo could not be stored." : {
      "comment" : "A message displayed when the user tries to save their profile, but the photo could not be stored.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваши данные были сохранены, но фотографию сохранить не удалось."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тафсилоти шумо захира карда шуд, аммо аксро нигоҳ доштан муяссар нашуд."
          }
        }
      }
    },
    "Your encrypted local replica and downloaded media will be removed from this device." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваша зашифрованная локальная копия и загруженные медиа будут удалены с этого устройства."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нусхаи маҳаллии рамзгузоришуда ва расонаҳои боршуда аз ин дастгоҳ нест мешаванд."
          }
        }
      }
    },
    "Your encrypted local replica and downloaded media will be removed. You can sign back in with your phone number at any time." : {
      "comment" : "A message displayed in a confirmation dialog when signing out.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваша зашифрованная локальная копия и загруженные медиа будут удалены. Вы сможете снова войти по номеру телефона в любое время."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нусхаи маҳаллии рамзгузоришуда ва расонаҳои боршуда нест мешаванд. Шумо ҳар вақт метавонед бо рақами телефон дубора ворид шавед."
          }
        }
      }
    },
    "Your identifying account data will be erased. Delivered messages remain in other participants’ chat history." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Идентифицирующие данные аккаунта будут удалены. Доставленные сообщения останутся в истории других участников."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Маълумоти шиносоии ҳисоби шумо нест мешавад. Паёмҳои расонидашуда дар таърихи дигар иштирокчиён мемонанд."
          }
        }
      }
    },
    "Your messages will appear here." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваши сообщения будут появляться здесь."
