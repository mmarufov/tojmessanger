      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone не сообщает приложениям о роуминге, поэтому включайте этот параметр, когда оператор тарифицирует данные в роуминге. Toj хранит на устройстве только этот выбор."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone ҳолати роумингро ба барномаҳо нишон намедиҳад, бинобар ин вақте оператор барои маълумоти роуминг маблағ мегирад, ин танзимро фаъол кунед. Toj дар дастгоҳ танҳо ҳамин интихобро нигоҳ медорад."
