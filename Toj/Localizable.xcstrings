    "Add your birthday when you’re ready. People you chat with can see it." : {
      "comment" : "A description of the birthday field.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавьте свой день рождения, когда будете готовы. Люди, с которыми вы общаетесь, могут это видеть."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вақте ки шумо омодаед, рӯзи таваллуди худро илова кунед. Одамоне, ки шумо бо онҳо сӯҳбат мекунед, метавонанд онро бубинанд."
          }
        }
      }
    },
    "Advanced privacy controls and security options are coming soon." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скоро появятся расширенные средства контроля конфиденциальности и параметры безопасности."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Назорати пешрафтаи махфият ва имконоти амниятӣ ба зудӣ меоянд."
          }
        }
      }
    },
    "All devices will be signed out and your identifying account data will be erased." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Все устройства выйдут из аккаунта, а идентифицирующие данные будут удалены."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ҳамаи дастгоҳҳо аз ҳисоб мебароянд ва маълумоти шиносоии шумо нест карда мешавад."
          }
        }
      }
    },
    "All downloaded media" : {
      "comment" : "Title of a media clear selection option that clears all downloaded media.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
