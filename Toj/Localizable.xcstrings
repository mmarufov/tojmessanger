    },
    "Your phone number is your Toj identity. Changing it will require a verification code so your account stays protected." : {
      "comment" : "A description of the phone number field.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Номер телефона — ваш идентификатор в Toj. Для его изменения потребуется код подтверждения, чтобы защитить аккаунт."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Рақами телефон шиносаи шумо дар Toj аст. Барои иваз кардани он рамзи тасдиқ лозим мешавад, то ҳисоб ҳифз гардад."
          }
        }
      }
    },
    "Your profile could not be saved. Please try again." : {
